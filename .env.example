# Configuración básica de la aplicación
NODE_ENV=development

# Base de datos y APIs (configurar según necesidad)
# DATABASE_URL=
# API_KEY=

# Configuración de internacionalización
NEXT_PUBLIC_DEFAULT_LANGUAGE=es

# Airtable (registro de marcas y leads de campaña)
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
# Los leads de /oportunidad y /contacto se guardan en la tabla "Emprendedores"
# (Name, Negocio, WhatsApp, Email, Origen, Fecha, Status, Brand, UTM Source,
# UTM Medium, UTM Campaign, UTM Term, UTM Content, Landing Path, Referrer, Click ID).

# Webhook que recibe cada lead nuevo. Incluye en el payload "continueUrl"
# (apunta a /retomar/[recordId]) para mandar follow-up de retargeting.
# CONTACT_WEBHOOK_URL=

# URL pública del sitio. Usada para construir continueUrl en el webhook del lead.
# En dev: http://localhost:3000. En prod: el dominio real.
# NEXT_PUBLIC_APP_URL=

# Google Cloud Storage (opcional - solo si TEST_UPLOAD=true)
# GCP_PROJECT_ID=your-project-id
# GCS_BUCKET_NAME=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Bandera para habilitar GCS
TEST_UPLOAD=false

# Configuración de Sentry (opcional)
# NEXT_PUBLIC_SENTRY_DSN=

# Token para limpieza automática de GCS (opcional)
# CLEANUP_API_TOKEN=migraflix-cleanup-2024